{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=vendorrisk;Username=vendorrisk;Password=vendorrisk",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDatasetPath": "data/SampleVendorData.json"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "VendorRisk.Api"
    }
  },
  "AllowedHosts": "*"
}
