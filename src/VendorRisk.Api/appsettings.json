{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=vendorrisk;Username=vendorrisk;Password=vendorrisk",
    "Redis": "localhost:6380"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDatasetPath": "data/SampleVendorData.json",
    "SeedCertificateCatalogPath": "data/SecurityCertificates.json"
  },
  "Scoring": {
    "RiskFactorMatrixPath": "data/RiskFactorMatrix.json"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "VendorRisk.Api"
    }
  },
  "AllowedHosts": "*"
}
